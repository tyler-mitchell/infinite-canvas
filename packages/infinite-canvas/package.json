{
  "name": "@infinite-canvas/react",
  "version": "0.1.0",
  "description": "An infinite-canvas window manager for React: a pure reducer core, real DOM window bodies, and a programmable WebGPU spatial surface.",
  "keywords": [
    "canvas",
    "headless",
    "infinite-canvas",
    "pan-zoom",
    "react",
    "react-three-fiber",
    "spatial",
    "webgpu",
    "window-manager",
    "workspace"
  ],
  "homepage": "https://github.com/tyler-mitchell/infinite-canvas#readme",
  "bugs": {
    "url": "https://github.com/tyler-mitchell/infinite-canvas/issues"
  },
  "license": "MIT",
  "author": "Tyler Davis Mitchell <tyler.davis.mitchell@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/infinite-canvas.git",
    "directory": "packages/infinite-canvas"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./scene": "./src/scene.ts",
    "./package.json": "./package.json",
    "./theme.css": "./src/theme.css"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./scene": "./dist/scene.mjs",
      "./package.json": "./package.json",
      "./theme.css": "./dist/theme.css"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack && cp src/theme.css dist/theme.css",
    "test": "vp test",
    "check": "vp check",
    "verify:api-doc": "node ./scripts/verify-api-doc.mjs",
    "verify:pure-core": "node ./scripts/verify-pure-core.mjs",
    "verify": "vp run build && node ./scripts/verify-artifact.mjs && node ./scripts/verify-api-doc.mjs && node ./scripts/verify-pure-core.mjs && node ./scripts/verify-api-stability.mjs",
    "prepublishOnly": "vp run verify",
    "verify:api-stability": "node ./scripts/verify-api-stability.mjs"
  },
  "dependencies": {
    "@legendapp/state": "catalog:",
    "@tanstack/hotkeys": "catalog:",
    "@zumer/snapdom": "catalog:"
  },
  "devDependencies": {
    "@react-three/fiber": "catalog:",
    "@types/node": "^25.6.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=10.0.0-canary.dbbe704 <11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.181.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
