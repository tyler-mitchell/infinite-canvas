{
  "name": "@hyphened/infinite-canvas",
  "version": "0.2.0",
  "description": "An infinite-canvas window manager for React: a pure reducer core, real DOM window bodies, and a programmable WebGPU spatial surface.",
  "keywords": [
    "canvas",
    "desktop",
    "headless",
    "infinite-canvas",
    "pan-zoom",
    "react",
    "spatial",
    "typegpu",
    "webgpu",
    "window-manager",
    "workspace"
  ],
  "homepage": "https://github.com/tyler-mitchell/infinite-canvas#readme",
  "bugs": {
    "url": "https://github.com/tyler-mitchell/infinite-canvas/issues"
  },
  "license": "MIT",
  "author": "Tyler Davis Mitchell <tyler.davis.mitchell@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/infinite-canvas.git",
    "directory": "packages/infinite-canvas"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./scene": "./src/scene.ts",
    "./package.json": "./package.json",
    "./theme.css": "./src/theme.css"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./scene": "./dist/scene.mjs",
      "./package.json": "./package.json",
      "./theme.css": "./dist/theme.css"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build",
    "test": "vp test",
    "check": "vp check",
    "verify:api-doc": "node ./scripts/verify-api-doc.mjs",
    "verify:pure-core": "node ./scripts/verify-pure-core.mjs",
    "verify": "vp run build && pnpm run verify:consumer && node ./scripts/verify-artifact.mjs && node ./scripts/verify-api-doc.mjs && node ./scripts/verify-pure-core.mjs && node ./scripts/verify-api-stability.mjs",
    "verify:consumer": "node ./scripts/verify-consumer-install.ts",
    "prepublishOnly": "vp run verify",
    "verify:api-stability": "node ./scripts/verify-api-stability.mjs"
  },
  "dependencies": {
    "@legendapp/state": "catalog:",
    "@tanstack/hotkeys": "catalog:",
    "@zumer/snapdom": "catalog:"
  },
  "devDependencies": {
    "@typegpu/noise": "catalog:",
    "@typegpu/react": "catalog:",
    "@typegpu/sdf": "catalog:",
    "@types/node": "^25.6.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@webgpu/types": "catalog:",
    "bumpp": "^11.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typegpu": "catalog:",
    "typescript": "^6.0.3",
    "unplugin-typegpu": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@typegpu/noise": "^0.12.0",
    "@typegpu/react": "^0.12.0",
    "@typegpu/sdf": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typegpu": "^0.12.3"
  },
  "peerDependenciesMeta": {
    "@typegpu/noise": {
      "optional": true
    },
    "@typegpu/react": {
      "optional": true
    },
    "@typegpu/sdf": {
      "optional": true
    },
    "typegpu": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
