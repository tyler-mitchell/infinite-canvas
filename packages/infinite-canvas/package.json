{
  "name": "@hyphened/infinite-canvas",
  "version": "0.2.1",
  "description": "An infinite-canvas window manager for React: a pure reducer core, real DOM window bodies, and a programmable WebGPU spatial surface.",
  "keywords": [
    "canvas",
    "desktop",
    "headless",
    "infinite-canvas",
    "pan-zoom",
    "react",
    "spatial",
    "typegpu",
    "webgpu",
    "window-manager",
    "workspace"
  ],
  "homepage": "https://github.com/tyler-mitchell/infinite-canvas#readme",
  "bugs": {
    "url": "https://github.com/tyler-mitchell/infinite-canvas/issues"
  },
  "license": "MIT",
  "author": "Tyler Davis Mitchell <tyler.davis.mitchell@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/infinite-canvas.git",
    "directory": "packages/infinite-canvas"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./legacy": "./legacy/index.ts",
    "./legacy/core": "./legacy/core.ts",
    "./legacy/scene": "./legacy/scene.ts",
    "./react": "./src/react/index.ts",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css",
    "./theme.css": "./src/theme.css",
    "./legacy/theme.css": "./legacy/theme.css"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./legacy": "./dist/legacy.mjs",
      "./legacy/core": "./dist/legacy/core.mjs",
      "./legacy/scene": "./dist/legacy/scene.mjs",
      "./react": "./dist/react.mjs",
      "./package.json": "./package.json",
      "./style.css": "./dist/style.css",
      "./theme.css": "./dist/theme.css",
      "./legacy/theme.css": "./dist/legacy/theme.css"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build",
    "test": "vp test",
    "check": "vp check",
    "typecheck": "vp check --no-fmt --no-lint",
    "verify:api-doc": "node ./scripts/verify-api-doc.mjs",
    "verify:pure-core": "node ./scripts/verify-pure-core.mjs",
    "verify": "vp run build && pnpm run verify:consumer && node ./scripts/verify-api-doc.mjs && node ./scripts/verify-pure-core.mjs && node ./scripts/verify-api-stability.mjs",
    "verify:consumer": "node ./scripts/verify-consumer-install.ts",
    "prepublishOnly": "vp run verify",
    "verify:api-stability": "node ./scripts/verify-api-stability.mjs"
  },
