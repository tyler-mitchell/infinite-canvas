{
  "include": ["src", "app", "portfolio", "server", "db", "env.d.ts"],
  "compilerOptions": {
    "paths": { "@/*": ["./app/*"] },
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    /* "node" is for tests that read a source file; nothing shipped touches a Node global. */
    "types": ["vite-plus/client", "node", "@webgpu/types"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
