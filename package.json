{
  "name": "infinite-canvas-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "react:doctor": "react-doctor --project packages/infinite-canvas,packages/portfolio-board --scope files --base HEAD --include-untracked --no-parallel --no-telemetry --no-supply-chain --blocking none",
    "check": "pnpm run ready",
    "ci:dispatch": "gh workflow run ci.yml",
    "ci:cancel": "gh run cancel",
    "ci:list": "gh run list --limit 10",
    "ci:logs": "gh run view --log-failed",
    "ci:rerun": "gh run rerun",
    "ci:watch": "gh run watch --exit-status",
    "dev": "vp run playground#dev",
    "playground": "vp run playground#dev",
    "polkadot": "vp run polkadot#dev",
    "portfolio-board": "vp run portfolio-board#dev",
    "site:build": "node scripts/site.ts build",
    "site:prepare": "node scripts/site.ts prepare",
    "site:source": "node scripts/site.ts source",
    "site:commit": "node scripts/site.ts commit",
    "compositor-poc": "vp run compositor-poc#dev",
    "prepare": "vp config",
    "ready": "vp check && vp run -r test && vp run -r build",
    "typecheck": "vp check --no-fmt --no-lint",
    "release:add": "bumpy add",
    "release:check": "bumpy check --strict",
    "release:merge": "gh pr merge bumpy/version-packages --auto --squash",
    "release:pr": "gh pr list --head bumpy/version-packages --base release --state open --limit 1",
    "release:registry-version": "npm view @hyphened/infinite-canvas version",
    "release:status": "bumpy status --json",
    "release:update": "gh pr update-branch bumpy/version-packages",
    "release:preflight": "node scripts/verify-package.ts",
    "release:verify": "node scripts/verify-release.ts",
    "setup:bumpy": "bumpy ci setup",
    "setup:branch-protection": "gh api --silent --method PUT repos/{owner}/{repo}/branches/release/protection --input .github/branch-protection.json",
    "setup:repository": "gh api --silent --method PATCH repos/{owner}/{repo} --field allow_auto_merge=true --field allow_update_branch=true --field delete_branch_on_merge=true",
    "workflow:check": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 .github/workflows/*.yml"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@varlock/bumpy": "catalog:",
    "cmd-mesh": "catalog:",
    "execa": "catalog:",
    "npm": "^11.15.0",
    "publint": "catalog:",
    "react-doctor": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.2"
}
