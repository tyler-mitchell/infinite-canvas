{
  "name": "infinite-canvas-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run ready",
    "ci:dispatch": "gh workflow run ci.yml",
    "ci:cancel": "gh run cancel",
    "ci:list": "gh run list --limit 10",
    "ci:logs": "gh run view --log-failed",
    "ci:rerun": "gh run rerun",
    "ci:watch": "gh run watch --exit-status",
    "dev": "vp run playground#dev",
    "prepare": "vp config",
    "ready": "vp check && vp run -r test && vp run -r build",
    "release:add": "bumpy add",
    "release:check": "bumpy check --strict",
    "release:publish-and-trust-new-package": "node scripts/publish-and-trust-new-package.ts",
    "release:merge": "gh pr merge bumpy/version-packages --squash",
    "release:pr": "gh pr view bumpy/version-packages",
    "release:registry-version": "npm view @hyphened/infinite-canvas version",
    "release:status": "bumpy status --json",
    "release:preflight": "node scripts/verify-package.ts",
    "release:verify": "node scripts/verify-release.ts",
    "setup:github": "node scripts/configure-github.ts",
    "setup:repository": "git remote add origin https://github.com/tyler-mitchell/infinite-canvas.git",
    "workflow:check": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 .github/workflows/*.yml"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@varlock/bumpy": "catalog:",
    "execa": "catalog:",
    "npm": "^11.15.0",
    "publint": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.2"
}
