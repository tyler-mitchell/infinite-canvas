{
  "name": "infinite-canvas-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "check:changeset": "changeset status",
    "dev": "vp run playground#dev",
    "prepare": "vp config",
    "ready": "vp check && vp run -r test && vp run -r build",
    "release": "pnpm release:preflight && changeset publish",
    "release:preflight": "pnpm --filter @hyphened/infinite-canvas run verify && changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@changesets/cli": "^2.31.1",
    "execa": "catalog:",
    "publint": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.2"
}
